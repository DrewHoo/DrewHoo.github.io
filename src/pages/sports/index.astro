---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getSportsSites, getSportsPosts, leagueMark } from '../../lib/sports';

const sites = await getSportsSites();
const posts = await getSportsPosts();

const description = `Anytime I see a really interesting factoid about a team or a player on the entertainment and sports programming network, I think to myself, 
	"What if there were an app that could tell you that for every player?" Well, here are those apps.`;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `sports — ${SITE_TITLE}`,
	url: new URL('/sports/', Astro.site).toString(),
	description,
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: sites.map((site, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: site.data.liveUrl,
			name: site.data.title,
		})),
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`sports — ${SITE_TITLE}`} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>sports</h1>
				<p class="lede">{description}</p>
			</section>

			<section aria-labelledby="sites-heading">
				<h2 id="sites-heading" class="sr-only">Sites</h2>
				<ol class="rows" role="list">
					{
						sites.map((site) => {
							const { title, line, blurb, league, liveUrl, repoUrl } = site.data;
							const mark = leagueMark(league);
							return (
								<li class="row">
									{mark ? (
										<span
											class="mark"
											style={`--mark: url(/sports/logos/${mark}.png)`}
											role="img"
											aria-label={league}
										/>
									) : (
										<span class="mark" aria-hidden="true" />
									)}
									<div class="body">
										<h3 class="title">
											<a href={liveUrl}>
												{title}
												<span class="arrow" aria-hidden="true"> ↗</span>
											</a>
										</h3>
										<p class="line">{line ?? blurb}</p>
									</div>
									{repoUrl && (
										<p class="src">
											<a href={repoUrl} rel="noopener">source</a>
										</p>
									)}
								</li>
							);
						})
					}
				</ol>
			</section>

			{
				posts.length > 0 && (
					<section class="writing" aria-labelledby="writing-heading">
						<h2 id="writing-heading">writing</h2>
						<ol class="rows posts" role="list">
							{posts.map((post) => (
								<li class="row">
									<div class="body">
										<h3 class="title">
											<a href={`/blog/${post.id}/`}>{post.data.title}</a>
										</h3>
										<p class="line">{post.data.description}</p>
									</div>
									{post.data.aiWritten && <p class="src">agent-written</p>}
								</li>
							))}
						</ol>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Lower elevation than the project cards: no shadow, no border box, no
	   buttons. A hairline between rows and the title underline do the work. */
	.hero {
		margin-top: 1rem;
		margin-bottom: 2rem;
	}
	.hero h1 {
		margin-bottom: 0.5em;
	}
	.lede {
		font-size: 1.15rem;
		max-width: 52ch;
		color: var(--ink-soft);
	}
	.rows {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: none;
		border-top: 1px solid var(--hairline);
	}
	.row {
		margin: 0;
		padding: 1.1rem 0 1.15rem;
		border-bottom: 1px solid var(--hairline);
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr) max-content;
		column-gap: 1rem;
		align-items: start;
	}
	.posts .row {
		grid-template-columns: minmax(0, 1fr) max-content;
	}
	/* the organization's one-color mark, painted in ink through a mask so it
	   reads in both schemes (the PNG's alpha is the shape) */
	.mark {
		display: block;
		width: 2rem;
		height: 2rem;
		margin-top: 0.05rem;
		background-color: var(--ink);
		-webkit-mask: var(--mark) center / contain no-repeat;
		mask: var(--mark) center / contain no-repeat;
	}
	.src {
		margin: 0;
		max-width: none;
		font-family: 'Space Mono', ui-monospace, monospace;
		font-size: 0.78rem;
		line-height: 1.5;
		padding-top: 0.3rem;
		color: var(--ink-soft);
		white-space: nowrap;
	}
	.body {
		min-width: 0;
	}
	.title {
		margin: 0 0 0.2rem;
		font-size: 1.2rem;
		line-height: 1.25;
	}
	.title a {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-decoration-color: var(--hot);
		text-underline-offset: 4px;
	}
	.title a:hover {
		background: var(--acid);
		color: var(--acid-ink);
	}
	.title a:visited {
		color: var(--ink);
	}
	.arrow {
		display: inline-block;
	}
	.line {
		margin: 0;
		max-width: 62ch;
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--ink-soft);
	}
	.src a {
		color: var(--ink-soft);
	}
	.writing {
		margin-top: 3rem;
	}
	.writing h2 {
		font-size: 1.15rem;
		margin-bottom: 0.75rem;
	}
	@media (max-width: 640px) {
		.row {
			column-gap: 0.75rem;
		}
		.mark {
			width: 1.6rem;
			height: 1.6rem;
			margin-top: 0.15rem;
		}
	}
</style>
