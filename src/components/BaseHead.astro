---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, ogType = 'website' } = Astro.props;
// A page without a cover of its own (the front page, /sports, /projects,
// /about) shares the site-level image from scripts/gen-og.mjs, so every URL
// unfurls with a picture. twitter:card is summary_large_image on all of
// them, which is an empty box without one.
const DEFAULT_OG_IMAGE = '/og-default.png';
const ogImage = new URL(image ?? DEFAULT_OG_IMAGE, Astro.url);
const ogImageIsDefault = !image;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico?v=3" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=3" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
<meta name="generator" content={Astro.generator} />

<link
	rel="preload"
	href="/fonts/space-mono-regular.woff2"
	as="font"
	type="font/woff2"
	crossorigin
/>
<link
	rel="preload"
	href="/fonts/space-mono-bold.woff2"
	as="font"
	type="font/woff2"
	crossorigin
/>
<link
	rel="preload"
	href="/fonts/atkinson-regular.woff"
	as="font"
	type="font/woff"
	crossorigin
/>

<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{
	ogImageIsDefault && (
		<>
			<meta property="og:image:width" content="1200" />
			<meta property="og:image:height" content="630" />
			<meta property="og:image:alt" content="drewhoover.com — Figured out, written down." />
		</>
	)
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script>
	import '../scripts/analytics.js';
</script>
